rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath(storeId, uid) {
      return /databases/$(database)/documents/stores/$(storeId)/users/$(uid);
    }
    function hasProfile(storeId) {
      return signedIn() && exists(userPath(storeId, request.auth.uid));
    }
    function profile(storeId) {
      return get(userPath(storeId, request.auth.uid)).data;
    }
    function activeMember(storeId) {
      return hasProfile(storeId) && profile(storeId).active == true;
    }
    function owner(storeId) { return activeMember(storeId) && profile(storeId).role == 'owner'; }
    function manager(storeId) { return activeMember(storeId) && profile(storeId).role == 'manager'; }
    function cashier(storeId) { return activeMember(storeId) && profile(storeId).role == 'kasir'; }
    function ownerOrManager(storeId) { return owner(storeId) || manager(storeId); }
    function managerOwnBranch(storeId, branchId) {
      return manager(storeId) && branchId == profile(storeId).branchId;
    }
    function canManageEmployee(storeId, role, branchId) {
      return owner(storeId) || (managerOwnBranch(storeId, branchId) && role == 'kasir');
    }
    function cashierPermissionsSafe(data) {
      return !('permissions' in data)
        || (data.permissions is list && data.permissions.hasOnly([
          'pos.use', 'transactions.view', 'products.view', 'customers.view',
          'customers.manage', 'shifts.view', 'shifts.manage', 'openBills.view',
          'orders.view', 'display.view', 'quotations.view', 'quotations.manage', 'warranty.view'
        ]));
    }
    function validEmployeeDirectory(data) {
      return data.keys().hasOnly([
          'uid', 'storeId', 'storeCode', 'branchId', 'loginName', 'loginAlias',
          'role', 'active', 'schemaVersion', 'updatedAt'
        ])
        && data.uid is string
        && data.storeId is string
        && data.storeCode is string
        && data.branchId is string
        && data.loginName is string
        && data.loginAlias is string
        && data.role in ['manager', 'kasir']
        && data.active is bool
        && data.schemaVersion == 2;
    }
    function validBranchPaymentProfile(data, branchId) {
      return data.keys().hasOnly([
          'branchId', 'merchantName', 'qrisImage', 'qrisInstruction',
          'qrisAssetMeta', 'enabled', 'updatedAt', 'updatedBy'
        ])
        && data.branchId == branchId
        && data.merchantName is string
        && data.merchantName.size() > 0
        && data.merchantName.size() <= 120
        && data.qrisImage is string
        && data.qrisImage.size() <= 600000
        && data.qrisInstruction is string
        && data.qrisInstruction.size() <= 240
        && data.enabled is bool
        && data.updatedBy is string;
    }
    function existingBranchAllowed(storeId) {
      return owner(storeId)
        || !('branchId' in resource.data)
        || resource.data.branchId == profile(storeId).branchId;
    }
    function incomingBranchAllowed(storeId) {
      return owner(storeId)
        || !('branchId' in request.resource.data)
        || request.resource.data.branchId == profile(storeId).branchId;
    }
    function managerApproval(storeId) {
      return request.resource.data.approvedBy is string
        && exists(userPath(storeId, request.resource.data.approvedBy))
        && get(userPath(storeId, request.resource.data.approvedBy)).data.active == true
        && get(userPath(storeId, request.resource.data.approvedBy)).data.role in ['owner', 'manager'];
    }
    function approvedRefundByCashier(storeId, refundId, saleId) {
      let refundPath = /databases/$(database)/documents/stores/$(storeId)/refunds/$(refundId);
      let refund = getAfter(refundPath).data;
      return refund.saleId == saleId
        && refund.createdBy == request.auth.uid
        && refund.approvedBy is string
        && exists(userPath(storeId, refund.approvedBy))
        && get(userPath(storeId, refund.approvedBy)).data.active == true
        && get(userPath(storeId, refund.approvedBy)).data.role in ['owner', 'manager'];
    }

    // Direktori login hanya dapat diambil berdasarkan ID hash cabang + nama.
    // Listing diblokir agar nama seluruh karyawan tidak dapat dipanen publik.
    match /employeeLoginDirectory/{directoryId} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && validEmployeeDirectory(request.resource.data)
        && canManageEmployee(
          request.resource.data.storeId,
          request.resource.data.role,
          request.resource.data.branchId
        )
        && getAfter(userPath(request.resource.data.storeId, request.resource.data.uid)).data.uid == request.resource.data.uid
        && getAfter(userPath(request.resource.data.storeId, request.resource.data.uid)).data.role == request.resource.data.role
        && getAfter(userPath(request.resource.data.storeId, request.resource.data.uid)).data.branchId == request.resource.data.branchId;
      allow update: if signedIn()
        && validEmployeeDirectory(request.resource.data)
        && resource.data.storeId == request.resource.data.storeId
        && canManageEmployee(resource.data.storeId, resource.data.role, resource.data.branchId)
        && canManageEmployee(
          request.resource.data.storeId,
          request.resource.data.role,
          request.resource.data.branchId
        )
        && getAfter(userPath(request.resource.data.storeId, request.resource.data.uid)).data.uid == request.resource.data.uid
        && getAfter(userPath(request.resource.data.storeId, request.resource.data.uid)).data.role == request.resource.data.role
        && getAfter(userPath(request.resource.data.storeId, request.resource.data.uid)).data.branchId == request.resource.data.branchId;
      allow delete: if signedIn()
        && resource.data.storeId is string
        && canManageEmployee(resource.data.storeId, resource.data.role, resource.data.branchId);
    }

    // Nota publik berisi data penjualan yang sudah disanitasi; harga modal dan data internal dilarang.
    match /publicReceipts/{token} {
      allow get: if resource.data.active == true && request.time < resource.data.expiresAt;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.storeId is string
        && activeMember(request.resource.data.storeId)
        && request.resource.data.active == true
        && request.resource.data.token == token
        && request.resource.data.keys().hasOnly(['token', 'storeId', 'active', 'expiresAt', 'createdAt', 'sale', 'store'])
        && request.resource.data.sale.keys().hasOnly([
          'id', 'branchId', 'createdAt', 'customerName', 'cashierName', 'items', 'subtotal',
          'globalDiscount', 'promoDiscount', 'loyaltyDiscount', 'tax', 'service',
          'total', 'change', 'payments'
        ])
        && request.resource.data.store.keys().hasOnly([
          'companyName', 'address', 'phone', 'receiptHeader', 'receiptFooter',
          'receiptMessage', 'receiptLogo', 'receiptShowLogo'
        ])
        && request.resource.data.sale.items.size() <= 200;
      allow update, delete: if resource.data.storeId is string && ownerOrManager(resource.data.storeId);
    }

    match /stores/{storeId}/system/bootstrap {
      // Signed-in user must be able to check the bootstrap document before the
      // first Owner profile exists. Listing remains blocked.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/stores/$(storeId)/system/bootstrap)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.storeId == storeId
        && request.resource.data.storeCode is string;
      allow update, delete: if owner(storeId);
    }

    match /stores/{storeId}/system/settings {
      allow read: if activeMember(storeId);
      allow create, delete: if owner(storeId);
      // Store Manager boleh mengelola kategori produk, tetapi tidak dapat
      // mengubah identitas usaha, keamanan, backup, atau pengaturan global.
      allow update: if owner(storeId)
        || (manager(storeId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['categories']));
    }

    // Daftar cabang aktif yang aman untuk layar login. Dokumen hanya memuat
    // nama toko/cabang, bukan data transaksi atau profil karyawan.
    match /stores/{storeId}/public/login {
      allow get: if true;
      allow list: if false;
      allow create, update: if owner(storeId)
        && request.resource.data.storeId == storeId
        && request.resource.data.branches is list;
      allow delete: if owner(storeId);
    }


    // Daftar nama tampilan karyawan aktif per cabang untuk dropdown login.
    // Dokumen ini tidak memuat UID, email, PIN, hash PIN, atau data transaksi.
    match /stores/{storeId}/publicEmployees/{branchId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if (owner(storeId) || managerOwnBranch(storeId, branchId))
        && request.resource.data.keys().hasOnly(['storeId', 'branchId', 'employees', 'updatedAt'])
        && request.resource.data.storeId == storeId
        && request.resource.data.branchId == branchId
        && request.resource.data.employees is list
        && request.resource.data.employees.size() <= 100;
      allow delete: if owner(storeId) || managerOwnBranch(storeId, branchId);
    }

    match /stores/{storeId}/users/{uid} {
      // Pengguna selalu boleh membaca profilnya sendiri. Owner melihat seluruh
      // karyawan; Store Manager hanya melihat Kasir pada cabangnya sendiri.
      allow get: if (
        (signedIn() && uid == request.auth.uid)
        || owner(storeId)
        || (manager(storeId) && resource.data.branchId == profile(storeId).branchId)
      );
      allow list: if owner(storeId)
        || (manager(storeId) && resource.data.branchId == profile(storeId).branchId);

      allow create: if (
          uid == request.resource.data.uid
          && request.resource.data.storeId == storeId
          && request.resource.data.role in ['manager', 'kasir']
          && request.resource.data.active is bool
          && canManageEmployee(storeId, request.resource.data.role, request.resource.data.branchId)
          && (owner(storeId) || cashierPermissionsSafe(request.resource.data))
        ) || (
          signedIn()
          && uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.storeId == storeId
          && request.resource.data.role == 'owner'
          && request.resource.data.active == true
          && getAfter(/databases/$(database)/documents/stores/$(storeId)/system/bootstrap).data.ownerUid == request.auth.uid
        );

      allow update: if (
          owner(storeId)
          && uid == request.auth.uid
          && resource.data.role == 'owner'
          && request.resource.data.role == 'owner'
          && request.resource.data.uid == request.auth.uid
        ) || (
          uid != request.auth.uid
          && request.resource.data.uid == uid
          && request.resource.data.storeId == storeId
          && resource.data.role in ['manager', 'kasir']
          && request.resource.data.role in ['manager', 'kasir']
          && canManageEmployee(storeId, resource.data.role, resource.data.branchId)
          && canManageEmployee(storeId, request.resource.data.role, request.resource.data.branchId)
          && (owner(storeId) || cashierPermissionsSafe(request.resource.data))
        );

      allow delete: if uid != request.auth.uid
        && resource.data.role in ['manager', 'kasir']
        && canManageEmployee(storeId, resource.data.role, resource.data.branchId);
    }

    match /stores/{storeId}/mutationReceipts/{mutationId} {
      allow read: if activeMember(storeId) && (ownerOrManager(storeId) || resource.data.userId == request.auth.uid);
      allow create: if activeMember(storeId)
        && request.resource.data.id == mutationId
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /stores/{storeId}/auditLogs/{id} {
      allow read: if owner(storeId)
        || (manager(storeId) && resource.data.branchId == profile(storeId).branchId);
      allow create: if activeMember(storeId)
        && request.resource.data.userId == request.auth.uid
        && (owner(storeId) || request.resource.data.branchId == profile(storeId).branchId);
      allow update, delete: if false;
    }

    match /stores/{storeId}/branches/{id} {
      allow read: if owner(storeId) || (activeMember(storeId) && id == profile(storeId).branchId);
      allow create, update, delete: if owner(storeId);
    }

    match /stores/{storeId}/products/{id} {
      allow read: if activeMember(storeId) && existingBranchAllowed(storeId);
      allow create: if ownerOrManager(storeId) && incomingBranchAllowed(storeId);
      allow update: if (ownerOrManager(storeId) && incomingBranchAllowed(storeId))
        || (cashier(storeId)
          && existingBranchAllowed(storeId)
          && incomingBranchAllowed(storeId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt']));
      allow delete: if ownerOrManager(storeId) && existingBranchAllowed(storeId);
    }

    match /stores/{storeId}/promotions/{id} {
      allow read: if activeMember(storeId) && existingBranchAllowed(storeId);
      allow create, update: if ownerOrManager(storeId) && incomingBranchAllowed(storeId);
      allow delete: if ownerOrManager(storeId) && existingBranchAllowed(storeId);
    }

    match /stores/{storeId}/suppliers/{id} {
      allow read: if ownerOrManager(storeId) && existingBranchAllowed(storeId);
      allow create, update: if ownerOrManager(storeId) && incomingBranchAllowed(storeId);
      allow delete: if ownerOrManager(storeId) && existingBranchAllowed(storeId);
    }

    match /stores/{storeId}/customers/{id} {
      allow read: if activeMember(storeId) && existingBranchAllowed(storeId);
      allow create: if (ownerOrManager(storeId) && incomingBranchAllowed(storeId))
        || (cashier(storeId)
          && incomingBranchAllowed(storeId)
          && request.resource.data.priceTier == 'retail'
          && request.resource.data.creditLimit == 0
          && request.resource.data.points == 0
          && request.resource.data.active == true);
      allow update: if (ownerOrManager(storeId) && incomingBranchAllowed(storeId))
        || (cashier(storeId)
          && existingBranchAllowed(storeId)
          && incomingBranchAllowed(storeId)
          && request.resource.data.points >= 0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'phone', 'email', 'address', 'project', 'notes', 'points', 'updatedAt'
          ]));
      allow delete: if ownerOrManager(storeId) && existingBranchAllowed(storeId);
    }

    match /stores/{storeId}/sales/{id} {
      allow read: if activeMember(storeId) && existingBranchAllowed(storeId);
      allow create: if activeMember(storeId)
        && incomingBranchAllowed(storeId)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if (ownerOrManager(storeId) && incomingBranchAllowed(storeId))
        || (cashier(storeId)
          && existingBranchAllowed(storeId)
          && incomingBranchAllowed(storeId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'refundedTotal', 'updatedAt']));
      allow delete: if owner(storeId) && existingBranchAllowed(storeId);
    }

    match /stores/{storeId}/heldSales/{id} {
      allow read: if activeMember(storeId) && existingBranchAllowed(storeId);
      allow create, update: if activeMember(storeId) && incomingBranchAllowed(storeId);
      allow delete: if activeMember(storeId) && existingBranchAllowed(storeId);
    }

    match /stores/{storeId}/purchases/{id} {
      allow read: if ownerOrManager(storeId) && existingBranchAllowed(storeId);
      allow create, update: if ownerOrManager(storeId) && incomingBranchAllowed(storeId);
      allow delete: if ownerOrManager(storeId) && existingBranchAllowed(storeId);
    }

    match /stores/{storeId}/stockMovements/{id} {
      allow read: if activeMember(storeId) && existingBranchAllowed(storeId);
      allow create: if activeMember(storeId)
        && incomingBranchAllowed(storeId)
        && request.resource.data.userId == request.auth.uid;
      allow update: if ownerOrManager(storeId) && incomingBranchAllowed(storeId);
      allow delete: if ownerOrManager(storeId) && existingBranchAllowed(storeId);
    }

    match /stores/{storeId}/stockAdjustments/{id} {
      allow read: if ownerOrManager(storeId) && existingBranchAllowed(storeId);
      allow create, update: if ownerOrManager(storeId) && incomingBranchAllowed(storeId);
      allow delete: if ownerOrManager(storeId) && existingBranchAllowed(storeId);
    }

    match /stores/{storeId}/stockOpnames/{id} {
      allow read: if ownerOrManager(storeId) && existingBranchAllowed(storeId);
      allow create, update: if ownerOrManager(storeId) && incomingBranchAllowed(storeId);
      allow delete: if ownerOrManager(storeId) && existingBranchAllowed(storeId);
    }

    match /stores/{storeId}/stockTransfers/{id} {
      allow read: if activeMember(storeId) && (
        owner(storeId)
        || resource.data.sourceBranchId == profile(storeId).branchId
        || resource.data.destinationBranchId == profile(storeId).branchId
      );
      // Manager hanya boleh mengirim stok dari cabang tugasnya. Transfer masuk
      // dibuat oleh Owner atau Manager cabang sumber, sehingga Manager tidak bisa
      // memanipulasi stok cabang lain dengan membuat transfer masuk palsu.
      allow create: if owner(storeId) || (manager(storeId)
        && request.resource.data.sourceBranchId == profile(storeId).branchId
        && request.resource.data.destinationBranchId != profile(storeId).branchId);
      allow update: if owner(storeId) || (manager(storeId)
        && resource.data.sourceBranchId == profile(storeId).branchId
        && request.resource.data.sourceBranchId == profile(storeId).branchId
        && request.resource.data.destinationBranchId != profile(storeId).branchId);
      allow delete: if owner(storeId) || (manager(storeId)
        && resource.data.sourceBranchId == profile(storeId).branchId);
    }

    match /stores/{storeId}/expenses/{id} {
      allow read: if ownerOrManager(storeId) && existingBranchAllowed(storeId);
      allow create, update: if ownerOrManager(storeId) && incomingBranchAllowed(storeId);
      allow delete: if ownerOrManager(storeId) && existingBranchAllowed(storeId);
    }

    match /stores/{storeId}/receivables/{id} {
      allow read: if activeMember(storeId) && existingBranchAllowed(storeId);
      allow create: if activeMember(storeId) && incomingBranchAllowed(storeId);
      allow update: if (ownerOrManager(storeId) && incomingBranchAllowed(storeId))
        || (cashier(storeId)
          && existingBranchAllowed(storeId)
          && incomingBranchAllowed(storeId)
          && request.resource.data.balance >= 0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'paid', 'balance', 'payments', 'status', 'updatedAt'
          ]));
      allow delete: if ownerOrManager(storeId) && existingBranchAllowed(storeId);
    }

    match /stores/{storeId}/payables/{id} {
      allow read: if ownerOrManager(storeId) && existingBranchAllowed(storeId);
      allow create, update: if ownerOrManager(storeId) && incomingBranchAllowed(storeId);
      allow delete: if ownerOrManager(storeId) && existingBranchAllowed(storeId);
    }

    match /stores/{storeId}/refunds/{id} {
      allow read: if activeMember(storeId) && existingBranchAllowed(storeId);
      allow create: if (ownerOrManager(storeId) && incomingBranchAllowed(storeId))
        || (cashier(storeId) && incomingBranchAllowed(storeId) && managerApproval(storeId));
      allow update: if owner(storeId) && incomingBranchAllowed(storeId);
      allow delete: if owner(storeId) && existingBranchAllowed(storeId);
    }

    match /stores/{storeId}/shifts/{id} {
      allow read: if activeMember(storeId) && existingBranchAllowed(storeId);
      allow create: if activeMember(storeId)
        && incomingBranchAllowed(storeId)
        && request.resource.data.userId == request.auth.uid;
      allow update: if (ownerOrManager(storeId) && incomingBranchAllowed(storeId))
        || (cashier(storeId)
          && existingBranchAllowed(storeId)
          && incomingBranchAllowed(storeId)
          && request.resource.data.userId == request.auth.uid);
      allow delete: if owner(storeId) && existingBranchAllowed(storeId);
    }

    match /stores/{storeId}/cashMovements/{id} {
      allow read: if activeMember(storeId) && existingBranchAllowed(storeId);
      allow create: if activeMember(storeId)
        && incomingBranchAllowed(storeId)
        && request.resource.data.userId == request.auth.uid;
      allow update: if ownerOrManager(storeId) && incomingBranchAllowed(storeId);
      allow delete: if ownerOrManager(storeId) && existingBranchAllowed(storeId);
    }

    match /stores/{storeId}/onlineOrders/{id} {
      allow read: if activeMember(storeId) && existingBranchAllowed(storeId);
      allow create, update: if ownerOrManager(storeId) && incomingBranchAllowed(storeId);
      allow delete: if ownerOrManager(storeId) && existingBranchAllowed(storeId);
    }

    match /stores/{storeId}/printerProfiles/{id} {
      allow read: if activeMember(storeId);
      allow create, update, delete: if ownerOrManager(storeId);
    }

    // QRIS disimpan per cabang dalam dokumen terpisah agar gambar tidak
    // membebani dokumen settings global dan tidak memicu konflik antar cabang.
    match /stores/{storeId}/branchPaymentProfiles/{id} {
      allow read: if activeMember(storeId) && (
        owner(storeId)
        || resource.data.branchId == profile(storeId).branchId
      );
      allow create, update: if validBranchPaymentProfile(request.resource.data, id)
        && (owner(storeId) || managerOwnBranch(storeId, request.resource.data.branchId));
      allow delete: if owner(storeId)
        || (manager(storeId) && resource.data.branchId == profile(storeId).branchId);
    }

    match /stores/{storeId}/campaigns/{id} {
      allow read: if activeMember(storeId);
      allow create, update, delete: if ownerOrManager(storeId);
    }

    match /stores/{storeId}/feedback/{id} {
      allow read: if ownerOrManager(storeId) && existingBranchAllowed(storeId);
      allow create: if activeMember(storeId) && incomingBranchAllowed(storeId);
      allow update: if ownerOrManager(storeId) && incomingBranchAllowed(storeId);
      allow delete: if ownerOrManager(storeId) && existingBranchAllowed(storeId);
    }


    // Riwayat harga bersifat append-only agar perubahan modal dan harga jual
    // dapat diaudit tanpa membiarkan histori lama ditulis ulang.
    match /stores/{storeId}/productPriceHistory/{id} {
      allow read: if ownerOrManager(storeId) && existingBranchAllowed(storeId);
      allow create: if ownerOrManager(storeId) && incomingBranchAllowed(storeId)
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Purchase Order menggunakan pembatasan cabang yang sama dengan pembelian.
    match /stores/{storeId}/purchaseOrders/{id} {
      allow read: if ownerOrManager(storeId) && existingBranchAllowed(storeId);
      allow create, update: if ownerOrManager(storeId) && incomingBranchAllowed(storeId);
      allow delete: if ownerOrManager(storeId) && existingBranchAllowed(storeId);
    }

    // Riwayat harga pemasok juga append-only. Hanya Owner/Manager yang dapat
    // membaca dan menulis agar harga modal pemasok tidak terekspos ke kasir.
    match /stores/{storeId}/supplierPriceHistory/{id} {
      allow read: if ownerOrManager(storeId) && existingBranchAllowed(storeId);
      allow create: if ownerOrManager(storeId) && incomingBranchAllowed(storeId)
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Penawaran dapat dibuat oleh anggota aktif pada cabangnya. Ini mendukung
    // kasir membuat quotation tanpa membuka akses pembelian atau harga modal.
    match /stores/{storeId}/quotations/{id} {
      allow read: if activeMember(storeId) && existingBranchAllowed(storeId);
      allow create, update: if activeMember(storeId) && incomingBranchAllowed(storeId);
      allow delete: if ownerOrManager(storeId) && existingBranchAllowed(storeId);
    }

    // Serial dapat dibaca kasir untuk pemilihan unit di POS. Master serial tetap
    // Owner/Manager, tetapi kasir boleh melakukan transisi IN_STOCK -> SOLD
    // sebagai bagian transaksi penjualan miliknya sendiri. getAfter() memastikan
    // sale tujuan sudah ada di transaction/batch Firestore yang sama atau sudah
    // berhasil disinkronkan oleh chunk sebelumnya.
    match /stores/{storeId}/serialNumbers/{id} {
      allow read: if activeMember(storeId) && existingBranchAllowed(storeId);
      allow create: if ownerOrManager(storeId) && incomingBranchAllowed(storeId);
      allow update: if (ownerOrManager(storeId) && incomingBranchAllowed(storeId))
        || (cashier(storeId)
          && existingBranchAllowed(storeId)
          && incomingBranchAllowed(storeId)
          && (
            (resource.data.status == 'IN_STOCK'
              && request.resource.data.status == 'SOLD'
              && request.resource.data.saleId is string
              && request.resource.data.saleId.size() > 0
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'saleId', 'customerId', 'customerName', 'soldAt',
                'warrantyStartAt', 'warrantyEndsAt', 'updatedAt'
              ])
              && getAfter(/databases/$(database)/documents/stores/$(storeId)/sales/$(request.resource.data.saleId)).data.createdBy == request.auth.uid
              && getAfter(/databases/$(database)/documents/stores/$(storeId)/sales/$(request.resource.data.saleId)).data.branchId == request.resource.data.branchId)
            ||
            (resource.data.status == 'SOLD'
              && request.resource.data.status in ['IN_STOCK', 'RETURNED']
              && request.resource.data.lastRefundId is string
              && request.resource.data.lastRefundId.size() > 0
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'saleId', 'customerId', 'customerName', 'soldAt',
                'warrantyStartAt', 'warrantyEndsAt', 'returnedAt', 'previousSaleId',
                'lastRefundId', 'lastRefundAt', 'updatedAt'
              ])
              && approvedRefundByCashier(storeId, request.resource.data.lastRefundId, resource.data.saleId))
          ));
      allow delete: if ownerOrManager(storeId) && existingBranchAllowed(storeId);
    }

    match /stores/{storeId}/warrantyClaims/{id} {
      allow read: if activeMember(storeId) && existingBranchAllowed(storeId);
      allow create, update: if ownerOrManager(storeId) && incomingBranchAllowed(storeId);
      allow delete: if ownerOrManager(storeId) && existingBranchAllowed(storeId);
    }

    // Persetujuan diskon/refund dapat dibuat oleh kasir pada cabangnya, tetapi
    // hanya Owner/Manager yang boleh memutuskan atau menghapusnya.
    match /stores/{storeId}/approvalRequests/{id} {
      allow read: if activeMember(storeId) && existingBranchAllowed(storeId);
      allow create: if activeMember(storeId) && incomingBranchAllowed(storeId)
        && request.resource.data.requestedBy == request.auth.uid;
      allow update: if ownerOrManager(storeId) && incomingBranchAllowed(storeId);
      allow delete: if ownerOrManager(storeId) && existingBranchAllowed(storeId);
    }

    // Sesi perangkat tidak berisi PIN atau password. Pengguna hanya dapat
    // menulis sesi miliknya sendiri; Owner dapat melihat seluruh daftar.
    match /stores/{storeId}/deviceSessions/{id} {
      allow read: if owner(storeId) || (activeMember(storeId) && resource.data.userId == request.auth.uid);
      allow create, update: if activeMember(storeId)
        && request.resource.data.userId == request.auth.uid
        && incomingBranchAllowed(storeId);
      allow delete: if owner(storeId) || (activeMember(storeId) && resource.data.userId == request.auth.uid);
    }
  }
}
