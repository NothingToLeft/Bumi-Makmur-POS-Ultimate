# Salin menjadi .env untuk pengembangan lokal.
# Nilai Firebase Web App tersedia di Firebase Console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Identitas database toko. Jangan diubah setelah toko sudah dibuat.
VITE_FIREBASE_STORE_ID=bumi-makmur
VITE_FIREBASE_STORE_CODE=BUMIMAKMUR02

# URL publik Cloudflare Pages/Vercel/Netlify tanpa garis miring di akhir.
# Dipakai untuk nota online dan tautan WhatsApp.
VITE_PUBLIC_APP_URL=https://bumi-makmur.my.id

# Gemini API key sengaja TIDAK diletakkan di .env/source.
# Atur dari Pengaturan → AI & Otomasi pada perangkat tepercaya; key disimpan lokal per perangkat.
