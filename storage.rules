rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function sameStore(storeId) { return signedIn() && request.auth.token.storeId == storeId; }
    function managerOrOwner() { return request.auth.token.role in ['owner', 'manager']; }

    match /stores/{storeId}/assets/{allPaths=**} {
      allow read: if sameStore(storeId);
      allow write: if sameStore(storeId) && managerOrOwner() && request.resource.size < 15 * 1024 * 1024;
    }
  }
}
