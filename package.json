{
  "name": "bumi-makmur-pos",
  "private": true,
  "version": "4.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "android:add": "npm run build && npx cap add android && npx cap sync android && npm run android:prepare",
    "android:sync": "npm run build && npx cap sync android && npm run android:prepare",
    "android:open": "npx cap open android",
    "android:prepare": "node scripts/prepare-android.mjs",
    "test:core": "node --test tests/*.test.mjs",
    "firebase:emulators": "firebase emulators:start --only auth,firestore,functions,storage",
    "firebase:deploy": "firebase deploy --only firestore:rules,firestore:indexes,storage,functions,hosting",
    "firebase:deploy:backend": "firebase deploy --only firestore:rules,firestore:indexes,storage,functions",
    "firebase:deploy:hosting": "npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "@capacitor/android": "7.4.3",
    "@capacitor/core": "7.4.3",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "firebase": "12.16.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.3",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "vite": "6.0.7",
    "firebase-tools": "^14.0.0"
  },
  "description": "Bumi Makmur POS Hybrid Enterprise v4.2: startup stabil, sinkronisasi latar belakang, identitas BM premium, dan nota profesional."
}
