{
  "name": "bumi-makmur-pos",
  "private": true,
  "version": "6.5.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run audit:static",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "android:add": "npm run build && npx cap add android && npx cap sync android && npm run android:prepare",
    "android:sync": "npm run build && npx cap sync android && npm run android:prepare",
    "android:open": "npx cap open android",
    "android:prepare": "node scripts/prepare-android.mjs",
    "test:core": "node --test tests/*.test.mjs",
    "firebase:emulators": "npx --yes firebase-tools@14 emulators:start --only auth,firestore",
    "firebase:deploy": "npx --yes firebase-tools@14 deploy --only firestore:rules,firestore:indexes",
    "firebase:deploy:backend": "npx --yes firebase-tools@14 deploy --only firestore:rules,firestore:indexes",
    "firebase:deploy:hosting": "echo \"Hosting utama memakai Cloudflare Pages; jalankan npm run build lalu deploy folder dist.\"",
    "web:build": "npm run build",
    "pc:preview": "npm run build && npm run preview",
    "audit:static": "node scripts/audit-project.mjs",
    "desktop:dev": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --dir --win --x64",
    "desktop:dist": "npm run build && electron-builder --win --x64 --publish never",
    "desktop:dist:nsis": "npm run build && electron-builder --win nsis --x64 --publish never",
    "desktop:dist:msi": "npm run build && electron-builder --win msi --x64 --publish never"
  },
  "dependencies": {
    "@capacitor/android": "7.6.10",
    "@capacitor/core": "7.6.10",
    "@zxing/browser": "0.2.1",
    "firebase": "12.16.0",
    "lucide-react": "0.468.0",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.10",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "electron": "43.8.4",
    "electron-builder": "26.15.3",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.17",
    "vite": "6.4.5"
  },
  "description": "Bumi Makmur POS v6.5.1 Professional Readiness: seluruh fitur v6.4.2 dipertahankan, ditambah diagnosa login PIN Owner yang akurat, perpanjangan otomatis masa berlaku kredensial offline, dan tier pelanggan (Bronze/Silver/Gold/Platinum) tanpa mengubah alur poin atau data produksi.",
  "main": "electron/main.cjs",
  "build": {
    "appId": "app.bumimakmur.pos.desktop",
    "productName": "Bumi Makmur POS Desktop",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release/windows",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "name": "bumi-makmur-pos-desktop"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Bumi-Makmur-POS-Desktop-v${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bumi Makmur POS Desktop",
      "deleteAppDataOnUninstall": false
    },
    "msi": {
      "oneClick": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "copyright": "Copyright © 2026 Bumi Makmur"
  },
  "allowScripts": {
    "@firebase/util": true,
    "protobufjs": true,
    "google-logging-utils": true,
    "re2": true,
    "esbuild": true,
    "electron": true,
    "app-builder-bin": true
  },
  "author": "Bumi Makmur",
  "license": "UNLICENSED"
}
