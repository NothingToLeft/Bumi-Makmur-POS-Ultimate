{
  "name": "bumi-makmur-pos",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "android:add": "npm run build && npx cap add android && npm run android:prepare && npx cap sync android",
    "android:sync": "npm run build && npm run android:prepare && npx cap sync android",
    "android:open": "npx cap open android",
    "android:prepare": "node scripts/prepare-android.mjs",
    "test:core": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "7.4.3",
    "@capacitor/core": "7.4.3",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.3",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "vite": "6.0.7"
  },
  "description": "Bumi Makmur POS Ultimate: POS local-first untuk toko bahan bangunan, listrik, dan air."
}
